# 1. CORE PROJECT OVERRIDES (Allow List)
# Keep tracked build scripts/config even if in a 'build' folder
!Build/*.ps1
!Build/*.json
!**/packages/build/

# 2. POWERSHELL & PESTER
# Pester test results and code coverage
*-tests.xml
*-help.xml
TestResults/
Artifacts/
CodeCoverage.xml
PSModuleAnalyzer.Settings.psd1

# Local development files
.profile.ps1
*.ps1.bak
*.log

# 3. IDE - VS CODE & JETBRAINS
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace
*.copilot-recovery

# History and backup extensions
.history/
.ionide/
.idea/

# 4. BUILD & PACKAGE MANAGEMENT
# Directories
[Bb]in/
[Bb]inary/
[Oo]bj/
[Oo]bjects/
[Dd]ebug/
[Rr]elease/
publish/
out/
output/
PSRepository.Archive/

# Dependencies
node_modules/
packages/
nugets/
# *.nupkg

# 5. OS & SYSTEM JUNK
# Windows
Thumbs.db

$RECYCLE.BIN/

# Archives
*.zip
*.tar.gz
*.7z

# 6. SECURITY & SENSITIVE DATA
# Secrets and environment variables
.env
.env.local
*.pem
*.pfx
*.key
*.kdbx
SecretStore/
